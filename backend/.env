# ──────────────────────────────────────────
#  Smart Government Schemes – Environment
# ──────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB  (local)
MONGO_URI=mongodb://localhost:27017/smart_gov_schemes
# MongoDB  (Atlas) – replace the template below
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart_gov_schemes?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRE=7d

# Initial admin account (used only by the seed script)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@smartgov.in
ADMIN_PASSWORD=Admin@1234

# Frontend origin (for CORS)
FRONTEND_URL=http://localhost:3000
